# Single public entrypoint with automatic HTTPS (set DOMAIN in .env to a real domain pointing at this server).
{$DOMAIN:localhost} {
	encode gzip zstd

	# NextAuth lives in the frontend; everything else under /api, /ws and /health is the FastAPI backend.
	@nextauth path /api/auth/*
	handle @nextauth {
		reverse_proxy frontend:3000
	}
	@backend path /api/* /ws/* /health
	handle @backend {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
