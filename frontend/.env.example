# Public URL of the API as seen by the BROWSER. Empty = same origin (use the Caddy reverse proxy in deploy/).
NEXT_PUBLIC_API_URL=
# Optional explicit WebSocket base (defaults to NEXT_PUBLIC_API_URL with ws://)
NEXT_PUBLIC_WS_URL=
# How the Next.js SERVER reaches the API (inside Docker: http://backend:8000)
API_INTERNAL_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
# generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
