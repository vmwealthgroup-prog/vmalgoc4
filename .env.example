# Generate real values with:  python scripts/init_env.py      (it copies this file to .env and fills the secrets)
DOMAIN=localhost
POSTGRES_PASSWORD=
SECRET_KEY=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# Who becomes admin when they register (leave empty and promote nobody, or set your email)
ADMIN_EMAIL=
ALLOW_REGISTRATION=true

# Access mode. false = OPEN MODE: no login, anyone who can reach the server is the owner (paper trading only).
# true = login required. You can switch inside the app: Settings, Access. If this server is on the public internet, turn login on first thing.
AUTH_REQUIRED=false

# HARD SAFETY SWITCH. While false, no real order can be sent, whatever any user sets. Turn on only after weeks of paper trading.
LIVE_TRADING_ENABLED=false

# Market data for the live dashboard and paper fills: demo (synthetic) | openalgo | crypto
FEED_SOURCE=demo
FEED_SYMBOLS=BTC/USD:CRYPTO,NIFTY:NSE,BANKNIFTY:NSE,RELIANCE:NSE
RUNNER_INTERVAL_S=30
# Needed when FEED_SOURCE=openalgo (your self-hosted OpenAlgo gateway)
OPENALGO_HOST=http://host.docker.internal:5000
OPENALGO_API_KEY=
# In multi-user hosting, list the OpenAlgo hostnames users may connect to (SSRF protection), e.g. host.docker.internal
OPENALGO_ALLOWED_HOSTS=
CRYPTO_EXCHANGE=coinbase

# --- Automation, safety and compliance
ENFORCE_MARKET_HOURS=true          # only trade Indian exchanges while open (crypto is 24x7)
MARKET_HOLIDAYS=                   # YYYY-MM-DD,YYYY-MM-DD ... exchange holidays: YOU maintain this each year
SQUARE_OFF_TIME=15:15              # IST: intraday (MIS) positions are flattened from this time
MAX_ORDERS_PER_SECOND=5            # global cap; stay well under the 10/s regulatory threshold
BREAKER_DEFAULT_TRADES=10          # strategy circuit breaker defaults (overridable per strategy)
BREAKER_DEFAULT_LOSS_PCT=3.0
KITE_MARKET_PROTECTION=            # optional, passed to Zerodha on market orders
CHARGES_JSON=                      # override the paper-trading Indian charge model, e.g. {"stt_options_sell_pct": 0.1}

# --- Alerts (any combination). Secrets stay here, never in the database.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=

# --- Real crypto ticks and AI
CRYPTO_FEED=coinbase               # real BTC trades from Coinbase's public WebSocket. Use demo for offline development (synthetic prices)
# COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
ANTHROPIC_API_KEY=                 # optional: lets the AI Analyst use Claude. Empty = built-in rule-based analyst. Never put this in front-end code
AI_MODEL=claude-sonnet-5-5
AI_MAX_PER_HOUR=20
